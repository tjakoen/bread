# dependencies
node_modules/
poc/node_modules/

# bun
.bun/

# build/export artifacts (BATCH is no-build; this is just-in-case)
dist/

# Playwright e2e artifacts
test-results/
playwright-report/
.playwright/

# generated UI snapshots (bun run shots)
screenshots/

# generated perf + SEO/AEO audit output (bun run audit) — ROOT ONLY: a bare `audit/` also
# swallowed batch/audit/ (the engine SOURCE) and it silently never got committed
/audit/

# graphify knowledge graph (generated, per-machine; rebuilt by the post-commit hook)
graphify-out/

# local tooling / editor / OS
.claude/
.DS_Store
*.log

# env
.env
.env.*

# PROOF board screenshots (build artifacts)
proof/screenshots/
pantry/screenshots/

# Intentionally lockless: bun can't resolve the depth-3 nested github git-dep graph (see package.json note)
bun.lock
